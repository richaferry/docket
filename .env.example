# Where this app is reachable from the internet — used to build the
# client-facing invoice link in emails. Update to your real domain once
# deployed, then restart the server.
PUBLIC_URL=http://localhost:3000

# Postgres connection string. Use a Neon pooled URL in production; a local or
# Docker Postgres in development (see docker-compose.yml for a ready one).
DATABASE_URL=postgres://docket:docket@localhost:5432/docket

# Neon: unpooled (direct) connection string. Required for running migrations
# against Neon — its pooled URL can reject DDL. `npm run db:migrate` uses this
# when present and falls back to DATABASE_URL otherwise.
DATABASE_URL_UNPOOLED=

# Platform signing key for short-lived auth tokens (email verification,
# password reset). MUST be a long random string in production and stable
# across restarts — on Vercel each serverless instance must sign/verify with
# the same key. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Email delivery for auth emails (verification, password reset).
MAILANVIL_KEY=
PLATFORM_EMAIL=no-reply@example.com

# Set to 1/true to close the platform to new signups.
#DISABLE_SIGNUP=false
