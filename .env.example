# Where this app is reachable from the internet — used to build the
# client-facing invoice link in emails. Update to your real domain once
# deployed, then restart the server.
PUBLIC_URL=http://localhost:3000

# Postgres connection string. Use a Neon pooled URL in production; a local or
# Docker Postgres in development (see docker-compose.yml for a ready one).
DATABASE_URL=postgres://docket:docket@localhost:5432/docket
